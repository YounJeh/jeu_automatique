# Choisir le modèle utilisé par Mastra
MASTRA_MODEL=google/gemini-3.6-flash

# Les vraies clés doivent être configurées dans GitHub Codespaces Secrets
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Longueur maximale du prompt de génération de jeu
MAX_GAME_PROMPT_LENGTH=1000

# Chemin du fichier de stockage des jeux générés (jamais fourni par le modèle)
GENERATED_GAMES_FILE=public/generated-games/generated-games.json
