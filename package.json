{
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "mastra": "^1.23.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "tsc && node scripts/vendor-zod.mjs",
    "typecheck": "tsc --noEmit",
